{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridmind.local/schemas/node-b-status.schema.json",
  "title": "GridMind Node B physical-unit status response",
  "description": "Target contract for GET /api/status after the simulated-euro firmware revision. This contract remains implementation evidence only after Arduino and physical verification.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "gameReady", "totalCents", "grid", "workload", "rates", "lastDecision"],
      "properties": {
        "node": { "const": "node-b" },
        "gameReady": { "const": true },
        "totalCents": { "type": "integer" },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capacityKw", "renewablePct", "co2eGPerKwh", "tempC", "tempLimitC", "nowMin"],
          "properties": {
            "capacityKw": { "type": "integer", "minimum": 0, "maximum": 20000 },
            "renewablePct": { "type": "integer", "minimum": 0, "maximum": 100 },
            "co2eGPerKwh": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "tempC": { "type": "integer", "minimum": 0, "maximum": 50 },
            "tempLimitC": { "type": "integer", "minimum": 0, "maximum": 50 },
            "nowMin": { "type": "integer", "minimum": 0, "maximum": 1439 }
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["customer", "job", "energyKwh", "durationMin", "demandKw", "tempRiseC", "contractEur", "flexible", "deadlineMin", "slackMin", "progressPct", "status"],
          "properties": {
            "customer": { "type": "string", "minLength": 1 },
            "job": { "type": "string", "minLength": 1 },
            "energyKwh": { "type": "integer", "minimum": 1000, "maximum": 20000 },
            "durationMin": { "type": "integer", "minimum": 15, "maximum": 240 },
            "demandKw": { "type": "integer", "minimum": 250, "maximum": 80000 },
            "tempRiseC": { "type": "integer", "minimum": 0, "maximum": 10 },
            "contractEur": { "type": "integer", "minimum": 1000, "maximum": 100000 },
            "flexible": { "type": "boolean" },
            "deadlineMin": { "type": "integer", "minimum": 0, "maximum": 1439 },
            "slackMin": { "type": "integer", "minimum": -240, "maximum": 1439 },
            "progressPct": { "type": "integer", "enum": [0, 100] },
            "status": { "type": "string", "enum": ["pending", "complete", "failed"] }
          }
        },
        "rates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["co2eEurPerT", "overloadEurPerMw", "coolingEurPerC", "flexLateEur", "urgentLateEur", "reducePct", "deferMin"],
          "properties": {
            "co2eEurPerT": { "const": 100 },
            "overloadEurPerMw": { "const": 9000 },
            "coolingEurPerC": { "const": 6000 },
            "flexLateEur": { "const": 30000 },
            "urgentLateEur": { "const": 50000 },
            "reducePct": { "const": 60 },
            "deferMin": { "const": 15 }
          }
        },
        "lastDecision": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "energyUsedKwh", "demandKw", "overloadMw", "emissionsKg", "tempRiseUsedC", "projectedTempC", "tempLimitC", "excessTempC", "deliveredCents", "co2CostCents", "overloadCostCents", "coolingCostCents", "lateCostCents", "netCents", "totalCents", "nowMinAfter", "completionMin", "slackMinAfter", "statusAfter"],
              "properties": {
                "action": { "type": "string", "enum": ["run", "defer", "reduce"] },
                "energyUsedKwh": { "type": "integer", "minimum": 0, "maximum": 20000 },
                "demandKw": { "type": "integer", "minimum": 0, "maximum": 80000 },
                "overloadMw": { "type": "integer", "minimum": 0, "maximum": 80 },
                "emissionsKg": { "type": "integer", "minimum": 0, "maximum": 20000 },
                "tempRiseUsedC": { "type": "integer", "minimum": 0, "maximum": 10 },
                "projectedTempC": { "type": "integer", "minimum": 0, "maximum": 60 },
                "tempLimitC": { "type": "integer", "minimum": 0, "maximum": 50 },
                "excessTempC": { "type": "integer", "minimum": 0, "maximum": 60 },
                "deliveredCents": { "type": "integer", "minimum": 0 },
                "co2CostCents": { "type": "integer", "minimum": 0 },
                "overloadCostCents": { "type": "integer", "minimum": 0 },
                "coolingCostCents": { "type": "integer", "minimum": 0 },
                "lateCostCents": { "type": "integer", "minimum": 0 },
                "netCents": { "type": "integer" },
                "totalCents": { "type": "integer" },
                "nowMinAfter": { "type": "integer", "minimum": 0, "maximum": 1439 },
                "completionMin": { "type": "integer", "minimum": 0, "maximum": 1679 },
                "slackMinAfter": { "type": "integer", "minimum": -240, "maximum": 1439 },
                "statusAfter": { "type": "string", "enum": ["pending", "complete", "failed"] }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "const": "game_not_ready" },
            "message": { "const": "Node B game has not been initialised." }
          }
        }
      }
    }
  ]
}
