{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridmind.local/schemas/node-b-status.schema.json",
  "title": "GridMind Node B status response",
  "description": "Contract for GET /api/status. The route returns either a ready game snapshot or a controlled not-ready error.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "gameReady",
        "cumulativeScore",
        "grid",
        "workload"
      ],
      "properties": {
        "node": {
          "const": "node-b"
        },
        "gameReady": {
          "const": true
        },
        "cumulativeScore": {
          "type": "integer"
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity",
            "renewablePercent",
            "carbonIndex",
            "thermalHeadroom"
          ],
          "properties": {
            "capacity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "renewablePercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "carbonIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "thermalHeadroom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "energyCost",
            "heatCost",
            "value",
            "flexible",
            "deadline",
            "progressPercent",
            "status"
          ],
          "properties": {
            "energyCost": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "heatCost": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "flexible": {
              "type": "boolean"
            },
            "deadline": {
              "description": "Zero is possible after a missed deadline; valid starting workloads use 1 to 5.",
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "progressPercent": {
              "type": "integer",
              "enum": [0, 100]
            },
            "status": {
              "type": "string",
              "enum": ["pending", "complete", "failed"]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "const": "game_not_ready"
            },
            "message": {
              "const": "Node B game has not been initialised."
            }
          }
        }
      }
    }
  ]
}
